rules_version = '2';

/**
 * Enterprise Production Security Rules for SkillSwap (Project: skillswap-fe53d)
 * Enforces strict Authentication, Ownership Controls, Field Schema Validations,
 * Data Integrity, and Protection against Fraud & Privilege Escalation.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER SECURITY FUNCTIONS
    // =========================================================================

    /** Checks if the incoming request is from a authenticated user */
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    /** Checks if the authenticated user matches the specified target User ID */
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    /** Checks if the document exists in Firestore */
    function docExists(path) {
      return exists(path);
    }

    /** Helper to retrieve a document safely */
    function getDoc(path) {
      return get(path);
    }

    /** Checks string length boundaries */
    function isValidString(str, minLen, maxLen) {
      return str is string && str.size() >= minLen && str.size() <= maxLen;
    }

    /** Checks if a field hasn't been modified during an update operation */
    function isUnchanged(fieldName) {
      return !(fieldName in request.resource.data) || 
        request.resource.data[fieldName] == resource.data[fieldName];
    }

    // =========================================================================
    // 1. USERS COLLECTION (/users/{userId})
    // =========================================================================
    match /users/{userId} {
      /**
       * READ: Any authenticated student can view public student profiles.
       */
      allow read: if isAuthenticated();

      /**
       * CREATE: Users can create their own profile matching their Auth UID.
       * Enforces schema rules and prevents self-assigning inflated ratings.
       */
      allow create: if isOwner(userId)
        && isValidString(request.resource.data.fullName, 2, 100)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.skillsOffered is list
        && request.resource.data.skillsOffered.size() <= 20
        && request.resource.data.skillsWanted is list
        && request.resource.data.skillsWanted.size() <= 20
        && request.resource.data.rating == 5.0 // Initial rating default
        && request.resource.data.completedSwaps == 0; // Initial swap counter

      /**
       * UPDATE: Users can edit only their own profile details.
       * Prevents modifying immutable fields (uid, email) and tamper-proof fields (rating, completedSwaps).
       */
      allow update: if isOwner(userId)
        && isUnchanged('uid')
        && isUnchanged('email')
        && isUnchanged('rating') // Only Cloud Functions / backend can alter rating
        && isUnchanged('completedSwaps') // Only Cloud Functions can increment completed swaps
        && isValidString(request.resource.data.fullName, 2, 100)
        && request.resource.data.skillsOffered is list
        && request.resource.data.skillsOffered.size() <= 20
        && request.resource.data.skillsWanted is list
        && request.resource.data.skillsWanted.size() <= 20;

      /**
       * DELETE: Account deletion is disabled at direct SDK layer to prevent accidental data loss.
       */
      allow delete: if false;
    }

    // =========================================================================
    // 2. PROJECTS COLLECTION (/projects/{projectId})
    // =========================================================================
    match /projects/{projectId} {
      /**
       * READ: Any authenticated user can view active collaboration projects.
       */
      allow read: if isAuthenticated();

      /**
       * CREATE: Authenticated users can post projects where they are declared owner.
       */
      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid
        && isValidString(request.resource.data.title, 3, 150)
        && isValidString(request.resource.data.description, 10, 5000)
        && request.resource.data.requiredSkills is list
        && request.resource.data.requiredSkills.size() >= 1
        && request.resource.data.progressPercentage == 0
        && request.resource.data.status in ['open', 'in_progress', 'completed', 'closed'];

      /**
       * UPDATE: Editable strictly by the Project Owner OR Authorized Team Members.
       * Owners can update progress, title, status; members can join/leave.
       */
      allow update: if isAuthenticated() && (
        // Case A: Owner updates project details or progress
        (resource.data.ownerId == request.auth.uid 
          && isUnchanged('ownerId')
          && request.resource.data.progressPercentage >= 0 
          && request.resource.data.progressPercentage <= 100)
        ||
        // Case B: Authorized member joining or leaving the project
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt']))
      );

      /**
       * DELETE: Only the project owner can delete a project.
       */
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // =========================================================================
    // 3. CHATS COLLECTION (/chats/{chatId})
    // =========================================================================
    match /chats/{chatId} {
      /**
       * READ & UPDATE: Accessible ONLY to verified chat participants.
       */
      allow read, update: if isAuthenticated() 
        && request.auth.uid in resource.data.participants;

      /**
       * CREATE: User can initialize a chat session if they are included in participants list.
       */
      allow create: if isAuthenticated() 
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;

      /**
       * DELETE: Direct chat deletion is disabled.
       */
      allow delete: if false;

      // =======================================================================
      // MESSAGES SUBCOLLECTION (/chats/{chatId}/messages/{messageId})
      // =======================================================================
      match /messages/{messageId} {
        /**
         * READ: Only authenticated participants of the parent chat can read messages.
         */
        allow read: if isAuthenticated() 
          && request.auth.uid in getDoc(/databases/$(database)/documents/chats/$(chatId)).data.participants;

        /**
         * CREATE: Only authenticated participants can send messages into the chat.
         * Must set senderId to their own authenticated UID.
         */
        allow create: if isAuthenticated() 
          && request.auth.uid in getDoc(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.senderId == request.auth.uid
          && isValidString(request.resource.data.content, 1, 2000);

        /**
         * UPDATE & DELETE: Messages are immutable once sent for audit safety.
         */
        allow update, delete: if false;
      }
    }

    // =========================================================================
    // 4. CONNECTIONS COLLECTION (/connections/{connectionId})
    // =========================================================================
    match /connections/{connectionId} {
      /**
       * READ: Accessible only by the requester or the recipient.
       */
      allow read: if isAuthenticated() && (
        resource.data.requesterId == request.auth.uid || 
        resource.data.recipientId == request.auth.uid
      );

      /**
       * CREATE: Requester sends connection invite.
       * PREVENTS DUPLICATE REQUESTS: Requires connectionId to follow deterministic ID format
       * `requesterUid_recipientUid` or verifies no existing pending connection exists.
       */
      allow create: if isAuthenticated()
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.recipientId != request.auth.uid // Cannot connect to self
        && request.resource.data.status == 'pending'
        && (!docExists(/databases/$(database)/documents/connections/$(request.resource.data.requesterId + '_' + request.resource.data.recipientId)));

      /**
       * UPDATE: Recipient accepts/declines/blocks OR requester cancels.
       */
      allow update: if isAuthenticated() && (
        // Case A: Recipient responds to invitation ('accepted', 'rejected', 'blocked')
        (resource.data.recipientId == request.auth.uid 
          && isUnchanged('requesterId') 
          && isUnchanged('recipientId')
          && request.resource.data.status in ['accepted', 'rejected', 'blocked'])
        ||
        // Case B: Requester cancels pending request
        (resource.data.requesterId == request.auth.uid 
          && resource.data.status == 'pending')
      );

      /**
       * DELETE: Participant can remove connection.
       */
      allow delete: if isAuthenticated() && (
        resource.data.requesterId == request.auth.uid || 
        resource.data.recipientId == request.auth.uid
      );
    }

    // =========================================================================
    // 5. NOTIFICATIONS COLLECTION (/notifications/{notificationId})
    // =========================================================================
    match /notifications/{notificationId} {
      /**
       * READ: Notifications are strictly PRIVATE to the recipient.
       */
      allow read: if isAuthenticated() 
        && resource.data.recipientId == request.auth.uid;

      /**
       * CREATE: Authenticated users can send notifications to another recipient.
       */
      allow create: if isAuthenticated()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.read == false;

      /**
       * UPDATE: Recipient can mark their notification as read.
       */
      allow update: if isAuthenticated() 
        && resource.data.recipientId == request.auth.uid
        && isUnchanged('recipientId')
        && isUnchanged('senderId')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

      /**
       * DELETE: Recipient can delete notifications from their inbox.
       */
      allow delete: if isAuthenticated() 
        && resource.data.recipientId == request.auth.uid;
    }
  }
}
